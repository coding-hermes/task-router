[Unit]
Description=Provider-health dashboard static server (127.0.0.1:9095, generated by provider_health_dashboard.py)
Documentation=file:///home/kara/.hermes/scripts/provider_health_dashboard.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kara/.hermes/dashboards/provider-health
ExecStart=/usr/bin/python3 -m http.server 9095 --bind 127.0.0.1 --directory /home/kara/.hermes/dashboards/provider-health
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
